# AgriTech Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your local or Atlas URI)
# Example local: mongodb://127.0.0.1:27017/agritech_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/agritech_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/agritech_db

# Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173
